FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
MAX_REQUEST_BYTES=5242880
STUDENT_DB_PATH=./synthetic_students.json
CHROMA_DB_DIR=./chroma_db_gemini
CHAT_HISTORY_DB_PATH=./data/chat_history.sqlite3
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60
GOOGLE_API_KEY=
CHAT_MODEL=gemini-3.8-flash
CHAT_RETRIES=1
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=100
RETRIEVAL_K=4

# --- Assignment 2 ---
DEFAULT_MODE=agentic            # agentic | rag
SECURITY_MODE=on                # off only for the before/after security audit
ROUTER_MODEL=                   # optional cheaper model for intake/verifier (defaults to CHAT_MODEL)
VISION_MODEL=                   # optional model for transcript images (defaults to CHAT_MODEL)
AGENT_LLM_VERIFY=true           # LLM verifier on top of the deterministic checks
LLM_MIN_INTERVAL_SECONDS=4      # spacing between model calls (free tier)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
SESSION_COOKIE_SECURE=true      # set true when served over HTTPS (Render)
